{
  "rewrites": [
    { "source": "/en", "destination": "/" },
    { "source": "/en/", "destination": "/" },
    { "source": "/de", "destination": "/" },
    { "source": "/de/", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(en|de)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
